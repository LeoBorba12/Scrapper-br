+def _nomes_estritamente_compativeis(nome_consulta, nome_registro):
+    """
+    Valida compatibilidade estrita de nomes para evitar contaminações:
+    - Rejeita quando um é nome curto isolado (ex: 'Kaique', 'Fabiano') e o outro possui sobrenome adicional (ex: 'Kaique Kenji', 'Fabiano Souza').
+    - Aceita igualdade exata insensível a maiúsculas e espaços.
+    - Aceita nomes compostos longos contendo elipses da súmula (ex: 'Emerson Fabiano' vs 'Emerson Ju ... Emerson Fabiano Kerb ...').
+    """
+    if not nome_consulta or not nome_registro:
+        return False
+    n1 = nome_consulta.strip().lower()
+    n2 = nome_registro.strip().lower()
+    if n1 == n2:
+        return True
+
+    tokens1 = set(n1.split())
+    tokens2 = set(n2.split())
+
+    # Se um for nome simples único e o outro for composto com sobrenome diferente, não assume identidade
+    if len(tokens1) == 1 and len(tokens2) > 1:
+        return False
+    if len(tokens2) == 1 and len(tokens1) > 1:
+        return False
+
+    # Suporte a abreviações com reticências da súmula
+    clean1 = {t for t in tokens1 if t not in ('.', '...')}
+    clean2 = {t for t in tokens2 if t not in ('.', '...')}
+    if clean1 and clean2 and (clean1.issubset(clean2) or clean2.issubset(clean1)):
+        return True
+
+    return False
+
+
